<div class="sb-story" id="sbs-{{ section.id }}">
  <div class="sb-story__text">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sb-story__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="sb-story__heading">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="sb-story__body">{{ section.settings.body }}</p>
    {%- endif -%}
    <div class="sb-story__tags">
      {%- if section.settings.tag1 != blank -%}<span class="sb-story__tag">{{ section.settings.tag1 }}</span>{%- endif -%}
      {%- if section.settings.tag2 != blank -%}<span class="sb-story__tag">{{ section.settings.tag2 }}</span>{%- endif -%}
      {%- if section.settings.tag3 != blank -%}<span class="sb-story__tag">{{ section.settings.tag3 }}</span>{%- endif -%}
      {%- if section.settings.tag4 != blank -%}<span class="sb-story__tag">{{ section.settings.tag4 }}</span>{%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url }}" class="sb-cta sb-cta--gold">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
  <div class="sb-story__image">
    {%- if section.settings.image != blank -%}
      <img
        srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
        sizes="(max-width: 749px) 100vw, 50vw"
        src="{{ section.settings.image | image_url: width: 900 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="sb-story__img-placeholder"></div>
    {%- endif -%}
  </div>
</div>

<style>
  #sbs-{{ section.id }} {
    background: #0d1f2d;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 620px;
  }
  #sbs-{{ section.id }} .sb-story__text {
    padding: 88px 64px 88px 56px;
    display: flex; flex-direction: column; justify-content: center;
  }
  #sbs-{{ section.id }} .sb-story__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.3em; text-transform: uppercase;
    color: #c8a96e; margin-bottom: 20px;
  }
  #sbs-{{ section.id }} .sb-story__heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(56px, 7vw, 108px);
    line-height: 0.88; color: #fff;
    margin-bottom: 28px; letter-spacing: 0.01em;
  }
  #sbs-{{ section.id }} .sb-story__body {
    font-family: 'Inter', sans-serif;
    font-size: 15px; font-weight: 300;
    color: rgba(255,255,255,0.68); line-height: 1.9;
    margin-bottom: 36px; max-width: 460px;
  }
  #sbs-{{ section.id }} .sb-story__tags {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-bottom: 44px;
  }
  #sbs-{{ section.id }} .sb-story__tag {
    font-family: 'Inter', sans-serif;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: #c8a96e;
    border: 1px solid rgba(200,169,110,0.35);
    padding: 7px 16px;
  }
  #sbs-{{ section.id }} .sb-story__image {
    overflow: hidden;
    position: relative;
  }
  #sbs-{{ section.id }} .sb-story__image img,
  #sbs-{{ section.id }} .sb-story__img-placeholder {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
    transition: transform 0.8s ease;
  }
  #sbs-{{ section.id }} .sb-story__img-placeholder {
    background: linear-gradient(135deg, #1a3a52 0%, #0d1f2d 100%);
  }
  #sbs-{{ section.id }}:hover .sb-story__image img { transform: scale(1.04); }

  @media (max-width: 900px) {
    #sbs-{{ section.id }} { grid-template-columns: 1fr; }
    #sbs-{{ section.id }} .sb-story__text { padding: 56px 32px; order: 2; }
    #sbs-{{ section.id }} .sb-story__image { order: 1; min-height: 380px; }
    #sbs-{{ section.id }} .sb-story__heading { font-size: clamp(52px, 12vw, 84px); }
  }
  @media (max-width: 749px) {
    #sbs-{{ section.id }} .sb-story__text { padding: 48px 20px; }
    #sbs-{{ section.id }} .sb-story__image { min-height: 300px; }
  }
</style>

{% schema %}
{
  "name": "SB — Brand Story",
  "tag": "div",
  "class": "sb-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More Than Just Apparel" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "NOT JUST A\nCLOTHING\nBRAND" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "SaltBred was born from early mornings on the water and late nights on the dock. We make gear for people who live at the coast — not just visit it." },
    { "type": "text", "id": "tag1", "label": "Tag 1", "default": "NakedSkin™ Technology" },
    { "type": "text", "id": "tag2", "label": "Tag 2", "default": "UPF 50+ Rated" },
    { "type": "text", "id": "tag3", "label": "Tag 3", "default": "Made for the Water" },
    { "type": "text", "id": "tag4", "label": "Tag 4", "default": "Coastal Heritage" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "OUR STORY" },
    { "type": "url", "id": "cta_url", "label": "CTA URL", "default": "/pages/our-story" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "SB — Brand Story" }]
}
{% endschema %}
