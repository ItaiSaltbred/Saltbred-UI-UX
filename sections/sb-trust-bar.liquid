      <div>
        <span class="sb-trust__title">Free Shipping</span>
        <span class="sb-trust__sub">On orders over $75</span>
      </div>
    </div>
    <div class="sb-trust__item">
      <svg class="sb-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
      <div>
        <span class="sb-trust__title">UPF 50+ Protection</span>
        <span class="sb-trust__sub">Maximum sun protection</span>
      </div>
    </div>
    <div class="sb-trust__item">
      <svg class="sb-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>
      <div>
        <span class="sb-trust__title">NakedSkin™ Tech</span>
        <span class="sb-trust__sub">Feels like nothing's there</span>
      </div>
    </div>
    <div class="sb-trust__item">
      <svg class="sb-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
      <div>
        <span class="sb-trust__title">Easy Returns</span>
        <span class="sb-trust__sub">30-day hassle-free</span>
      </div>
    </div>
  </div>
</div>

<style>
  #sbs-{{ section.id }} {
    background: #f7f5f0;
    border-top: 1px solid #e8e4dc;
    border-bottom: 1px solid #e8e4dc;
    padding: 24px 32px;
  }
  #sbs-{{ section.id }} .sb-trust__inner {
    max-width: 1280px; margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  #sbs-{{ section.id }} .sb-trust__item {
    display: flex; align-items: center; gap: 14px;
    padding: 4px 0;
  }
  #sbs-{{ section.id }} .sb-trust__icon {
    width: 32px; height: 32px;
    color: #c8a96e; flex-shrink: 0;
  }
  #sbs-{{ section.id }} .sb-trust__title {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 17px; letter-spacing: 0.04em;
    color: #111; line-height: 1;
    margin-bottom: 3px;
  }
  #sbs-{{ section.id }} .sb-trust__sub {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 11px; color: #888;
    letter-spacing: 0.02em;
  }
  @media (max-width: 749px) {
    #sbs-{{ section.id }} { padding: 20px 16px; }
    #sbs-{{ section.id }} .sb-trust__inner {
      grid-template-columns: 1fr 1fr;
      gap: 20px 12px;
    }
  }
  @media (max-width: 480px) {
    #sbs-{{ section.id }} .sb-trust__inner { grid-template-columns: 1fr; }
  }
</style>

