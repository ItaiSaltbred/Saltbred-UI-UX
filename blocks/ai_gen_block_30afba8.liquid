{% doc %}
  @prompt
    Create a product information section with three collapsible accordion drop-down boxes. The first accordion should be labeled "Product Description" for product details, the second "Size Chart" for sizing information, and the third "Return Policy" for return information. Each accordion should expand and collapse when clicked, with customizable content fields for each section. Style should be clean and mobile-friendly with clear visual indicators for expand/collapse state.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-accordion-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .ai-product-accordion__item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-product-accordion__item-{{ ai_gen_id }}:first-child {
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-product-accordion__button-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .ai-product-accordion__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background }};
  }

  .ai-product-accordion__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  .ai-product-accordion__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-product-accordion__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-product-accordion__button-{{ ai_gen_id }}[aria-expanded="true"] .ai-product-accordion__icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-product-accordion__content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-product-accordion__content-{{ ai_gen_id }}.active {
    max-height: 2000px;
  }

  .ai-product-accordion__inner-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.padding_horizontal }}px {{ block.settings.padding_vertical }}px;
    color: {{ block.settings.content_color }};
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
  }

  .ai-product-accordion__inner-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-product-accordion__inner-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-product-accordion__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-product-accordion__inner-{{ ai_gen_id }} {
      font-size: {{ block.settings.content_size | times: 0.95 }}px;
    }
  }
{% endstyle %}

<product-accordion-{{ ai_gen_id }} class="ai-product-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-accordion__item-{{ ai_gen_id }}">
    <button
      class="ai-product-accordion__button-{{ ai_gen_id }}"
      aria-expanded="false"
      aria-controls="accordion-content-1-{{ ai_gen_id }}"
      data-accordion-trigger
    >
      <h3 class="ai-product-accordion__title-{{ ai_gen_id }}">{{ block.settings.accordion_1_title }}</h3>
      <span class="ai-product-accordion__icon-{{ ai_gen_id }}" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </button>
    <div
      class="ai-product-accordion__content-{{ ai_gen_id }}"
      id="accordion-content-1-{{ ai_gen_id }}"
      data-accordion-content
    >
      <div class="ai-product-accordion__inner-{{ ai_gen_id }}">
        {% if block.settings.accordion_1_content != blank %}
          {{ block.settings.accordion_1_content }}
        {% else %}
          {% if product.description != blank %}
            {{ product.description }}
          {% else %}
            <p>Add product description details here.</p>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="ai-product-accordion__item-{{ ai_gen_id }}">
    <button
      class="ai-product-accordion__button-{{ ai_gen_id }}"
      aria-expanded="false"
      aria-controls="accordion-content-2-{{ ai_gen_id }}"
      data-accordion-trigger
    >
      <h3 class="ai-product-accordion__title-{{ ai_gen_id }}">{{ block.settings.accordion_2_title }}</h3>
      <span class="ai-product-accordion__icon-{{ ai_gen_id }}" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </button>
    <div
      class="ai-product-accordion__content-{{ ai_gen_id }}"
      id="accordion-content-2-{{ ai_gen_id }}"
      data-accordion-content
    >
      <div class="ai-product-accordion__inner-{{ ai_gen_id }}">
        {% if block.settings.accordion_2_content != blank %}
          {{ block.settings.accordion_2_content }}
        {% else %}
          <p>Add size chart information here.</p>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="ai-product-accordion__item-{{ ai_gen_id }}">
    <button
      class="ai-product-accordion__button-{{ ai_gen_id }}"
      aria-expanded="false"
      aria-controls="accordion-content-3-{{ ai_gen_id }}"
      data-accordion-trigger
    >
      <h3 class="ai-product-accordion__title-{{ ai_gen_id }}">{{ block.settings.accordion_3_title }}</h3>
      <span class="ai-product-accordion__icon-{{ ai_gen_id }}" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </button>
    <div
      class="ai-product-accordion__content-{{ ai_gen_id }}"
      id="accordion-content-3-{{ ai_gen_id }}"
      data-accordion-content
    >
      <div class="ai-product-accordion__inner-{{ ai_gen_id }}">
        {% if block.settings.accordion_3_content != blank %}
          {{ block.settings.accordion_3_content }}
        {% else %}
          <p>Add return policy information here.</p>
        {% endif %}
      </div>
    </div>
  </div>
</product-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.triggers = this.querySelectorAll('[data-accordion-trigger]');
        this.contents = this.querySelectorAll('[data-accordion-content]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.triggers.forEach((trigger, index) => {
          trigger.addEventListener('click', () => {
            const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
            const content = this.contents[index];

            if (isExpanded) {
              this.closeAccordion(trigger, content);
            } else {
              this.openAccordion(trigger, content);
            }
          });
        });
      }

      openAccordion(trigger, content) {
        trigger.setAttribute('aria-expanded', 'true');
        content.classList.add('active');
      }

      closeAccordion(trigger, content) {
        trigger.setAttribute('aria-expanded', 'false');
        content.classList.remove('active');
      }
    }

    customElements.define('product-accordion-{{ ai_gen_id }}', ProductAccordion{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product accordion",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product description"
    },
    {
      "type": "text",
      "id": "accordion_1_title",
      "label": "Title",
      "default": "Product Description"
    },
    {
      "type": "richtext",
      "id": "accordion_1_content",
      "label": "Content",
      "info": "Leave empty to use product description"
    },
    {
      "type": "header",
      "content": "Size chart"
    },
    {
      "type": "text",
      "id": "accordion_2_title",
      "label": "Title",
      "default": "Size Chart"
    },
    {
      "type": "richtext",
      "id": "accordion_2_content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Return policy"
    },
    {
      "type": "text",
      "id": "accordion_3_title",
      "label": "Title",
      "default": "Return Policy"
    },
    {
      "type": "richtext",
      "id": "accordion_3_content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "content_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Content size",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "hover_background",
      "label": "Hover background",
      "default": "#f5f5f5"
    }
  ],
  "presets": [
    {
      "name": "Product accordion"
    }
  ]
}
{% endschema %}
