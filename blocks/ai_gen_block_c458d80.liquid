{% doc %}
  @prompt
    Create a large promotional popup block using this image: https://cdn.shopify.com/s/files/1/0957/6051/5348/files/Stickerpopup_b7d31883-004e-4bc8-8b22-54c07c0d6ce5.png?v=1776807520. The popup should: display only the image (no email signup, no form, no input fields), be large/big in size (taking up most of the viewport, at least 90vw wide on mobile), have a close (X) button in the top-right corner of the popup, close when the user clicks/taps outside the popup on the dark overlay, have a semi-transparent dark overlay behind it, appear automatically after a short delay, have a theme setting to upload/change the promo image, and have settings for popup delay, overlay opacity, and close button styling., Make it smaller. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-popup-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-promo-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-promo-popup-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    cursor: pointer;
  }

  .ai-promo-popup-container-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 600px;
    max-height: 80vh;
    width: auto;
    height: auto;
    z-index: 10000;
  }

  .ai-promo-popup-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-popup-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-promo-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.close_button_offset }}px;
    right: {{ block.settings.close_button_offset }}px;
    width: {{ block.settings.close_button_size }}px;
    height: {{ block.settings.close_button_size }}px;
    background-color: {{ block.settings.close_button_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10001;
    transition: background-color 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .ai-promo-popup-close-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.close_button_hover_bg }};
    transform: scale(1.1);
  }

  .ai-promo-popup-close-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.close_button_size }}px * 0.5);
    height: calc({{ block.settings.close_button_size }}px * 0.5);
    stroke: {{ block.settings.close_button_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-promo-popup-container-{{ ai_gen_id }} {
      max-width: 85vw;
      max-height: 75vh;
    }

    .ai-promo-popup-image-{{ ai_gen_id }} {
      max-height: 75vh;
    }

    .ai-promo-popup-close-{{ ai_gen_id }} {
      width: calc({{ block.settings.close_button_size }}px * 0.8);
      height: calc({{ block.settings.close_button_size }}px * 0.8);
      top: calc({{ block.settings.close_button_offset }}px * 0.8);
      right: calc({{ block.settings.close_button_offset }}px * 0.8);
    }

    .ai-promo-popup-close-{{ ai_gen_id }} svg {
      width: calc({{ block.settings.close_button_size }}px * 0.4);
      height: calc({{ block.settings.close_button_size }}px * 0.4);
    }
  }
{% endstyle %}

<promo-popup-{{ ai_gen_id }}
  class="ai-promo-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.popup_delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-promo-popup-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-promo-popup-container-{{ ai_gen_id }}">
    <div class="ai-promo-popup-content-{{ ai_gen_id }}">
      {% if block.settings.promo_image %}
        <img
          src="{{ block.settings.promo_image | image_url: width: 1200 }}"
          alt="{{ block.settings.promo_image.alt | escape }}"
          class="ai-promo-popup-image-{{ ai_gen_id }}"
          loading="eager"
          width="{{ block.settings.promo_image.width }}"
          height="{{ block.settings.promo_image.height }}"
        >
      {% endif %}
      <button
        class="ai-promo-popup-close-{{ ai_gen_id }}"
        aria-label="Close popup"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</promo-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.delay = parseInt(this.dataset.delay) * 1000;
        this.hasBeenShown = false;
      }

      connectedCallback() {
        this.overlay = this.querySelector('.ai-promo-popup-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-promo-popup-close-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.showPopupAfterDelay();
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.closePopup());
        this.overlay.addEventListener('click', () => this.closePopup());

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      showPopupAfterDelay() {
        if (this.hasBeenShown) return;

        setTimeout(() => {
          this.classList.add('active');
          this.hasBeenShown = true;
          document.body.style.overflow = 'hidden';
        }, this.delay);
      }

      closePopup() {
        this.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('promo-popup-{{ ai_gen_id }}', PromoPopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Promo popup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Popup image"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promo image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Popup behavior"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Delay before showing",
      "default": 2
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0.8
    },
    {
      "type": "header",
      "content": "Close button"
    },
    {
      "type": "range",
      "id": "close_button_size",
      "min": 24,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Button size",
      "default": 40
    },
    {
      "type": "range",
      "id": "close_button_offset",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Button offset",
      "default": 12
    },
    {
      "type": "color",
      "id": "close_button_bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "close_button_hover_bg",
      "label": "Hover background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "close_button_color",
      "label": "Icon color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Promo popup"
    }
  ]
}
{% endschema %}