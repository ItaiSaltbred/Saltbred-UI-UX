{% doc %}
  @prompt
    Create a marquee (scrolling ticker/announcement banner) section with an embedded clickable link. The scrolling text should say "FATHERS DAY SALE" and when clicked, it should navigate to /pages/fathers-day-sale. Include theme editor settings for: marquee text, destination URL, scroll speed, background color, and text color. The text should scroll continuously in a loop from right to left. Style it to look bold and premium, fitting a coastal lifestyle brand.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    position: relative;
    display: block;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
  }

  .ai-marquee-link-{{ ai_gen_id }} {
    display: flex;
    white-space: nowrap;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
    will-change: transform;
  }

  .ai-marquee-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_color }};
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-marquee-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {% if block.settings.uppercase %}uppercase{% else %}none{% endif %};
    padding: 0 {{ block.settings.text_spacing }}px;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<marquee-banner-{{ ai_gen_id }}
  class="ai-marquee-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <a
      href="{{ block.settings.destination_url }}"
      class="ai-marquee-link-{{ ai_gen_id }}"
      aria-label="{{ block.settings.marquee_text }}"
    >
      <div class="ai-marquee-content-{{ ai_gen_id }}">
        {% for i in (1..20) %}
          <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.marquee_text }}</span>
        {% endfor %}
      </div>
    </a>
  </div>
</marquee-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.link = this.querySelector('.ai-marquee-link-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-marquee-content-{{ ai_gen_id }}');
        
        this.link.addEventListener('mouseenter', () => {
          this.content.style.animationPlayState = 'paused';
        });
        
        this.link.addEventListener('mouseleave', () => {
          this.content.style.animationPlayState = 'running';
        });
      }
    }

    customElements.define('marquee-banner-{{ ai_gen_id }}', MarqueeBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Marquee banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "FATHERS DAY SALE"
    },
    {
      "type": "url",
      "id": "destination_url",
      "label": "Destination URL"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 30,
      "info": "Lower number = faster scroll"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Font",
      "default": "anton_n4"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase text",
      "default": true
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Text spacing",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Marquee banner"
    }
  ]
}
{% endschema %}