    },
    {
      "type": "color",
      "id": "in_stock_bg_color",
      "label": "Background",
      "default": "#E8F5E9"
    },
    {
      "type": "color",
      "id": "in_stock_text_color",
      "label": "Text",
      "default": "#2E7D32"
    },
    {
      "type": "color",
      "id": "in_stock_border_color",
      "label": "Border",
      "default": "#A5D6A7"
    },
    {
      "type": "color",
      "id": "in_stock_dot_color",
      "label": "Dot",
      "default": "#4CAF50"
    },
    {
      "type": "header",
      "content": "Out of stock"
    },
    {
      "type": "text",
      "id": "out_of_stock_text",
      "label": "Text",
      "default": "Out of Stock"
    },
    {
      "type": "color",
      "id": "out_of_stock_bg_color",
      "label": "Background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "out_of_stock_text_color",
      "label": "Text",
      "default": "#757575"
    },
    {
      "type": "color",
      "id": "out_of_stock_border_color",
      "label": "Border",
      "default": "#E0E0E0"
    },
    {
      "type": "color",
      "id": "out_of_stock_dot_color",
