{% doc %}
  @prompt
    Create an announcement bar with continuous horizontal scrolling ticker animation where text slides smoothly from right to left across the screen in a loop, like a news ticker or marquee effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ticker-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
    position: relative;
  }

  .ai-ticker-bar__track-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-ticker-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-ticker-bar__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    padding: 0 {{ block.settings.item_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  {% if block.settings.show_separator %}
    .ai-ticker-bar__separator-{{ ai_gen_id }} {
      display: inline-block;
      width: {{ block.settings.separator_size }}px;
      height: {{ block.settings.separator_size }}px;
      background-color: {{ block.settings.separator_color }};
      border-radius: 50%;
      margin: 0 {{ block.settings.item_spacing }}px;
    }
  {% endif %}

  .ai-ticker-bar-{{ ai_gen_id }}:hover .ai-ticker-bar__track-{{ ai_gen_id }} {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  @keyframes ai-ticker-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
{% endstyle %}

<ticker-bar-{{ ai_gen_id }}
  class="ai-ticker-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-ticker-bar__track-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% for j in (1..block.settings.repeat_count) %}
        <div class="ai-ticker-bar__item-{{ ai_gen_id }}">
          {{ block.settings.ticker_text }}
        </div>
        {% if block.settings.show_separator %}
          <span class="ai-ticker-bar__separator-{{ ai_gen_id }}"></span>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</ticker-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class TickerBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-ticker-bar__track-{{ ai_gen_id }}');
        this.adjustAnimation();
      }

      adjustAnimation() {
        if (!this.track) return;
        
        const trackWidth = this.track.scrollWidth / 2;
        const containerWidth = this.offsetWidth;
        
        if (trackWidth < containerWidth) {
          const itemsNeeded = Math.ceil(containerWidth / trackWidth) + 1;
          const currentItems = this.track.children.length / 2;
          
          for (let i = 0; i < itemsNeeded; i++) {
            const clone = this.track.cloneNode(true);
            Array.from(clone.children).forEach(child => {
              this.track.appendChild(child.cloneNode(true));
            });
          }
        }
      }
    }

    customElements.define('ticker-bar-{{ ai_gen_id }}', TickerBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement ticker",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "Free shipping on orders over $50 • New arrivals weekly • Shop now and save 20%"
    },
    {
      "type": "range",
      "id": "repeat_count",
      "label": "Repeat count",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 8,
      "info": "Number of times to repeat the text"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "default": 30,
      "info": "Lower is faster"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator",
      "default": true
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Announcement ticker"
    }
  ],
  "tag": null
}
{% endschema %}
