<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2EH4G2ESS5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2EH4G2ESS5');
    </script>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    <!-- SaltBred: Bebas Neue Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <!-- SaltBred Custom Styles -->
    <style>
      :root {
        --font-heading--family: 'Bebas Neue', sans-serif !important;
        --font-subheading--family: 'Bebas Neue', sans-serif !important;
        --font-h1--family: 'Bebas Neue', sans-serif !important;
        --font-h2--family: 'Bebas Neue', sans-serif !important;
        --font-h3--family: 'Bebas Neue', sans-serif !important;
        --font-h4--family: 'Bebas Neue', sans-serif !important;
        --font-h5--family: 'Bebas Neue', sans-serif !important;
        --font-h6--family: 'Bebas Neue', sans-serif !important;
        --font-paragraph--family: 'Inter', sans-serif !important;
        --font-body--family: 'Inter', sans-serif !important;
        --button-font-family-primary: 'Inter', sans-serif !important;
      }

      h1, h2, h3, h4, h5, h6,
      .card__heading, .card__heading a,
      .product-title, .collection-title {
        font-family: 'Bebas Neue', sans-serif !important;
        line-height: 1 !important;
      }

      body, p, a, li, span, div {
        font-family: 'Inter', sans-serif;
      }

      /* Shipping bar */
      .sb-shipping-bar {
        background: #111111;
        padding: 8px 20px;
        z-index: 200;
        position: relative;
      }
      .sb-shipping-bar__inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }
      .sb-shipping-bar__text {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.85);
        text-align: center;
      }
      .sb-shipping-bar__text strong { color: #c8a96e; }
      .sb-shipping-bar__track {
        height: 3px;
        background: rgba(255,255,255,0.12);
        border-radius: 2px;
        overflow: hidden;
        max-width: 400px;
        margin: 0 auto;
        width: 100%;
      }
      .sb-shipping-bar__fill {
        height: 100%;
        background: #c8a96e;
        border-radius: 2px;
        transition: width 0.5s ease;
        width: 0%;
      }

      /* Marquee gold */
      .marquee { background-color: #c8a96e !important; }
      .marquee__item, .marquee__text { color: #fff !important; font-family: 'Bebas Neue', sans-serif !important; }

      /* Dark footer */
      footer, .footer { background-color: #111 !important; }
      footer *, .footer * { color: rgba(255,255,255,0.65); }

      /* Buttons */
      .button { border-radius: 0 !important; font-family: 'Inter', sans-serif !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }

      /* Announcement bar */
      .announcement-bar, .header-announcements { background: #0d1f2d !important; }
    </style>

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  {% include 'pagefly-app-header' %}</head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    <!-- SaltBred Shipping Bar -->
    <div class="sb-shipping-bar">
      <div class="sb-shipping-bar__inner">
        <div class="sb-shipping-bar__text" id="sb-ship-msg">
          Add <strong>$75</strong> more for free shipping
        </div>
        <div class="sb-shipping-bar__track">
          <div class="sb-shipping-bar__fill" id="sb-ship-fill"></div>
        </div>
      </div>
    </div>

    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      (function setHeaderHeighCustomProperties() {
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');
        if (!header || !headerGroup) return;
        const headerHeight = header.offsetHeight;
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }
        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');
        document.body.style.setProperty('--transparent-header-offset-boolean', !hasImmediateSection ? '1' : '0');
      })();
    </script>

    <main id="MainContent" class="content-for-layout" role="main" data-page-transition-enabled="false" data-product-transition="false" data-template="{{ template }}">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% render 'search-modal' %}
    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <script>
      (function() {
        var THRESHOLD = 7500;
        function update() {
          fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart) {
            var total = cart.total_price;
            var rem = Math.max(0, THRESHOLD - total);
            var pct = Math.min(100, Math.round((total / THRESHOLD) * 100));
            var fill = document.getElementById('sb-ship-fill');
            var msg = document.getElementById('sb-ship-msg');
            if (!fill || !msg) return;
            fill.style.width = pct + '%';
            msg.innerHTML = total >= THRESHOLD
              ? '🎉 You\'ve unlocked free shipping!'
              : 'Add <strong style="color:#c8a96e">$' + (rem/100).toFixed(0) + '</strong> more for free shipping';
          });
        }
        document.addEventListener('DOMContentLoaded', update);
        document.addEventListener('cart:updated', update);
      })();
    </script>
  </body>
</html>
